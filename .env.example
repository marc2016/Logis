# ---------------------------------------------------------------
# Logis - deployment configuration
# Copy to .env and adjust the values. NEVER commit .env.
# ---------------------------------------------------------------

# --- Entry point (nginx) ---------------------------------------
# Address/port on which the stack listens for the reverse proxy.
# 127.0.0.1 = reachable only from the same host (proxy on the mini PC).
LOGIS_BIND=127.0.0.1
LOGIS_PORT=8080
# Addresses/networks whose X-Forwarded-For is accepted
# (address of the reverse proxy as seen by the container), comma-separated.
LOGIS_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

# --- Database --------------------------------------------------
POSTGRES_DB=logis
POSTGRES_USER=logis
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Initial admin (used only at the very first start) ---------
LOGIS_ADMIN_USERNAME=admin
# At least 12 characters
LOGIS_ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# --- Encryption of the TOTP secrets ----------------------------
# Generate with: openssl rand -base64 32
# Back it up SEPARATELY from the backups - without this key
# all users must set up 2FA again after a restore.
LOGIS_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# --- Module ----------------------------------------------------
LOGIS_MODULES_VACATIONRENTAL_ENABLED=true

# --- Backups ---------------------------------------------------
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14
