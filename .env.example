# ---------------------------------------------------------------
# Logis - Betriebskonfiguration
# Kopieren nach .env und Werte anpassen. .env NIE committen.
# ---------------------------------------------------------------

# --- Einstiegspunkt (nginx) ------------------------------------
# Adresse/Port, auf dem der Stack fuer den Reverse Proxy lauscht.
# 127.0.0.1 = nur vom selben Host erreichbar (Proxy auf dem Mini-PC).
LOGIS_BIND=127.0.0.1
LOGIS_PORT=8080
# Adressen/Netze, deren X-Forwarded-For uebernommen wird
# (Adresse des Reverse Proxys aus Sicht des Containers), komma-getrennt.
LOGIS_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

# --- Datenbank -------------------------------------------------
POSTGRES_DB=logis
POSTGRES_USER=logis
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Initialer Admin (nur beim allerersten Start verwendet) ----
LOGIS_ADMIN_USERNAME=admin
# Mindestens 12 Zeichen
LOGIS_ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# --- Verschluesselung der TOTP-Secrets -------------------------
# Erzeugen mit: openssl rand -base64 32
# GETRENNT von den Backups sichern - ohne diesen Schluessel
# muessen nach einem Restore alle Benutzer 2FA neu einrichten.
LOGIS_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# --- Module ----------------------------------------------------
LOGIS_MODULES_VACATIONRENTAL_ENABLED=true

# --- Backups ---------------------------------------------------
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14
